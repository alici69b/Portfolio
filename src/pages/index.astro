---
import "../styles/global.css";

import Plantilla from "../layouts/Plantilla.astro";
import Navegacion from "../components/Navegacion.astro";
import Portada from "../components/Portada.astro";
import SobreMi from "../components/SobreMi.astro";
import Educacion from "../components/Educacion.astro";
import Proyectos from "../components/Proyectos.astro";
import PieDePagina from "../components/PieDePagina.astro";
---

<Plantilla>
  <Navegacion />
  <main id="contenido" class="relative z-10">
    <Portada />
    <SobreMi />
    <Educacion />
    <Proyectos />
  </main>
  <PieDePagina />
</Plantilla>
