<section
  id="proyecto"
  class="relative border-y border-line/60 py-20 lg:py-28"
  aria-labelledby="projects-title"
>
  <div
    class="mx-auto w-[calc(100%_-_32px)] max-w-[1180px] sm:w-[calc(100%_-_40px)]"
  >
    <p
      class="inline-flex items-center gap-2.5 font-mono text-[0.75rem] font-medium uppercase leading-normal tracking-[0.13em] text-turquoise"
    >
      <span class="h-px w-6 bg-current" aria-hidden="true"></span>
      04 / proyectos
    </p>
    <h2
      id="projects-title"
      class="mt-4 font-display text-[clamp(2.1rem,4.4vw,3.75rem)] font-semibold leading-[1.04] tracking-[-0.045em]"
    >
      Proyectos.
    </h2>

    <div class="mt-9 grid items-stretch gap-5 md:grid-cols-2 xl:grid-cols-3">
      <article
        class="reveal group flex h-full flex-col overflow-hidden rounded-[20px] border border-line bg-linear-to-br from-surface/95 to-surface-2/90 transition duration-300 hover:-translate-y-1 hover:border-turquoise/40 hover:bg-surface"
      >
        <div
          class="relative aspect-video overflow-hidden border-b border-line/60 bg-night-deep"
        >
          <img
            class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.02] motion-reduce:transition-none"
            src="/portfolio.webp"
            alt="Captura del portfolio personal de Alicia"
            width="1902"
            height="861"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="flex flex-1 flex-col p-5 sm:p-6">
          <h3
            class="font-display text-xl font-semibold leading-tight tracking-[-0.03em] text-fg"
          >
            Portfolio personal
          </h3>
          <p class="mt-2.5 text-sm leading-[1.7] text-fg-muted">
            Mi portfolio personal, donde comparto quién soy y los proyectos en
            los que trabajo.
          </p>
          <ul
            class="flex flex-wrap gap-2 pt-5"
            role="list"
            aria-label="Tecnologías del portfolio personal"
          >
            <li
              class="rounded-[5px] border border-line bg-night/30 px-2.5 py-1 font-mono text-[0.67rem] leading-[1.4] text-fg-muted"
