              Tailwind CSS
            </li>
          </ul>
          <div class="mt-auto flex flex-wrap gap-2.5 pt-6">
        
            <a
              class="inline-flex min-h-10 flex-1 items-center justify-center rounded-lg border border-line bg-surface/65 px-4 text-sm font-semibold text-fg transition hover:-translate-y-0.5 hover:border-turquoise/50 hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-turquoise"
              href="https://github.com/alici69b/Portfoliopersonal">Repositorio</a
            >
          </div>
        </div>
      </article>

      <article
        class="reveal group flex h-full flex-col overflow-hidden rounded-[20px] border border-line bg-linear-to-br from-surface/95 to-surface-2/90 transition duration-300 hover:-translate-y-1 hover:border-turquoise/40 hover:bg-surface"
