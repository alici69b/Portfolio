<section
  id="formacion"
  class="relative border-t border-line/60 py-20 lg:py-28"
  aria-labelledby="formacion-title"
>
  <div
    class="mx-auto w-[calc(100%_-_32px)] max-w-[1180px] sm:w-[calc(100%_-_40px)]"
  >
    <p
      class="inline-flex items-center gap-2.5 font-mono text-[0.75rem] font-medium uppercase leading-normal tracking-[0.13em] text-turquoise"
    >
      <span class="h-px w-6 bg-current" aria-hidden="true"></span>
      03 / formación
    </p>

    <h2
      id="formacion-title"
      class="mt-4 font-display text-[clamp(2.1rem,4.4vw,3.75rem)] font-semibold leading-[1.04] tracking-[-0.045em]"
    >
      Mi formación.
    </h2>

    <ol
      class="mx-auto mt-10 max-w-[820px] space-y-8 sm:mt-12 sm:space-y-10"
      role="list"
    >
      <li class="reveal relative pl-8 sm:pl-12">
        <span
          class="absolute bottom-[-64px] left-[7px] top-6 w-px bg-line sm:bottom-[-78px] sm:left-[9px] sm:top-7"
          aria-hidden="true"></span>
        <span
          class="absolute left-0 top-6 z-10 grid h-[15px] w-[15px] place-items-center rounded-full border border-turquoise/40 bg-night sm:top-7 sm:h-[19px] sm:w-[19px]"
          aria-hidden="true"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-turquoise sm:h-2 sm:w-2"></span>
        </span>

        <article
          class="min-w-0 rounded-[17px] border border-line bg-linear-to-br from-surface/95 to-surface-2/80 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-turquoise/40 sm:p-6"
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <p
              class="font-mono text-[0.72rem] uppercase leading-[1.4] tracking-[0.1em] text-turquoise"
            >
              <time datetime="2025">2025</time> - Actualidad
            </p>
            <span
              class="rounded-full border border-turquoise/30 bg-turquoise/10 px-2.5 py-1 font-mono text-[0.63rem] uppercase leading-[1.4] tracking-[0.08em] text-turquoise-soft"
            >
              En curso
            </span>
          </div>

          <h3
            class="mt-3 font-display text-[clamp(1.22rem,2.1vw,1.55rem)] font-semibold leading-[1.15] tracking-[-0.03em]"
          >
            Grado Superior en Desarrollo de Aplicaciones Web (DAW)
          </h3>
          <p class="mt-2 text-[0.84rem] leading-[1.6] text-fg-muted">
            IES La Arboleda (Lepe, Huelva)
          </p>
          <p class="mt-3 max-w-[62ch] text-[0.9rem] leading-[1.7] text-fg-muted">
            Formación en desarrollo frontend y backend, bases de datos y
            despliegue de aplicaciones web.
          </p>
        </article>
      </li>

      <li class="reveal relative pl-8 sm:pl-12">
        <span
          class="absolute left-0 top-6 z-10 grid h-[15px] w-[15px] place-items-center rounded-full border border-turquoise/40 bg-night sm:top-7 sm:h-[19px] sm:w-[19px]"
          aria-hidden="true"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-turquoise sm:h-2 sm:w-2"></span>
        </span>

        <article
          class="min-w-0 rounded-[17px] border border-line bg-linear-to-br from-surface/95 to-surface-2/80 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-turquoise/40 sm:p-6"
        >
          <p
            class="font-mono text-[0.72rem] uppercase leading-[1.4] tracking-[0.1em] text-turquoise"
          >
            <time datetime="2023">2023</time> -
            <time datetime="2025">2025</time>
          </p>

          <h3
            class="mt-3 font-display text-[clamp(1.22rem,2.1vw,1.55rem)] font-semibold leading-[1.15] tracking-[-0.03em]"
          >
            Grado Medio en Sistemas Microinformáticos y Redes (SMR)
          </h3>
          <p class="mt-2 text-[0.84rem] leading-[1.6] text-fg-muted">
            IES La Arboleda (Lepe, Huelva)
          </p>
          <p class="mt-3 max-w-[62ch] text-[0.9rem] leading-[1.7] text-fg-muted">
            Formación en instalación, configuración y mantenimiento de equipos
            informáticos y redes locales.
          </p>
        </article>
      </li>
    </ol>
  </div>
</section>
